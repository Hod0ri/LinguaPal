# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
RUN_MOD=Dev

# Database Settings (PostgreSQL)
DB_NAME=linguapal
DB_USER=linguapal_user
DB_PASSWORD=your-database-password-here
DB_HOST=db
DB_PORT=5432

# PostgreSQL Container Settings
POSTGRES_DB=linguapal
POSTGRES_USER=linguapal_user
POSTGRES_PASSWORD=your-database-password-here

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_OAUTH_SECRET=your-google-oauth-secret-here

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
RUN_MOD=DEV

# Google OAuth Credentials
# Get these from https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-here
GOOGLE_OAUTH_SECRET=your-google-client-secret-here

